# Copy to .env. Never commit .env.
CLOCK_PORT=4517
# Docker Compose serves localhost over HTTP; keep false unless you add HTTPS.
CLOCK_COOKIE_SECURE=false
# Exactly six digits. Leave empty here: Docker Compose refuses to start until you set one.
CLOCK_INITIAL_OWNER_PIN=
# Generate a long random value, e.g. `openssl rand -base64 32`.
AI_CONFIG_ENCRYPTION_KEY=
