{
  "name": "immersive-clock-11408",
  "main": "server/dist/worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // API 走 Worker；静态 HTML/JS/CSS/字体 asset-first 直接由边缘服务，避免每个资源消耗 Workers 请求。
    // SPA fallback 与静态安全头由 not_found_handling + web/public/_headers 承担。
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clock-11408",
      "database_id": "17851214-abca-41ee-a581-b0d8dccf3b3f"
    }
  ],
  // 每日备份：北京 23:00（15:00 UTC）把 events/sessions 写入 R2，滚动保留 30 天
  "r2_buckets": [
    {
      "binding": "BACKUP",
      "bucket_name": "clock-11408-backup"
    }
  ],
  "triggers": {
    "crons": ["0 15 * * *"]
  },
  "routes": [
    {
      "pattern": "clock.4c666.top",
      "custom_domain": true
    }
  ]
}
